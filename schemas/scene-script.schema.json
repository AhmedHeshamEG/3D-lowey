{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hesham/3d-lowey/schemas/scene-script.schema.json",
  "title": "3D-lowey Scene Script",
  "description": "A Scene Script: raw editing commands and/or friendly actions (v2), applied as ONE undoable step after a preview on the iPad. Actions use object names, times as seconds or spoken words, presets, cameras, characters. Full action reference: GET /v1/actions on the iPad bridge (LoweyCore ScriptReference).",
  "type": "object",
  "required": [
    "title"
  ],
  "properties": {
    "version": {
      "enum": [
        1,
        2
      ]
    },
    "title": {
      "type": "string"
    },
    "commands": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/command"
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "vec3": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "quat": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 4,
      "maxItems": 4,
      "description": "[x, y, z, w]"
    },
    "color": {
      "type": "string",
      "pattern": "^(#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?|palette:[0-9]+)$"
    },
    "propertyValue": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "float": {
          "type": "number"
        },
        "int": {
          "type": "integer"
        },
        "bool": {
          "type": "boolean"
        },
        "vec3": {
          "$ref": "#/$defs/vec3"
        },
        "quat": {
          "$ref": "#/$defs/quat"
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "string": {
          "type": "string"
        },
        "enum": {
          "type": "string"
        },
        "asset": {
          "$ref": "#/$defs/id"
        }
      },
      "additionalProperties": false
    },
    "kind": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "group",
            "primitive",
            "asset",
            "prefab",
            "drawing",
            "light",
            "camera",
            "text",
            "overlay",
            "particles"
          ]
        },
        "shape": {
          "enum": [
            "cube",
            "sphere",
            "cylinder",
            "cone",
            "plane",
            "torus",
            "ramp"
          ]
        },
        "asset": {
          "$ref": "#/$defs/id"
        },
        "prefab": {
          "$ref": "#/$defs/id"
        },
        "light": {
          "enum": [
            "directional",
            "point",
            "spot"
          ]
        },
        "drawing": {
          "type": "object",
          "required": [
            "style",
            "strokes",
            "normal",
            "depth",
            "segments"
          ],
          "properties": {
            "style": {
              "enum": [
                "tube",
                "ribbon",
                "extrude",
                "lathe"
              ]
            },
            "strokes": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "points",
                  "widths"
                ],
                "properties": {
                  "points": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/vec3"
                    }
                  },
                  "widths": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    }
                  }
                }
              }
            },
            "normal": {
              "$ref": "#/$defs/vec3"
            },
            "depth": {
              "type": "number"
            },
            "segments": {
              "type": "integer"
            }
          }
        }
      }
    },
    "object": {
      "type": "object",
      "required": [
        "id",
        "name",
        "kind",
        "children",
        "properties"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/kind"
        },
        "parent": {
          "$ref": "#/$defs/id"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "properties": {
          "type": "object",
          "description": "Known keys: position, rotation, scale, visible, locked, opacity, stepping (inherit|ones|twos|threes), color, emissive, emissiveIntensity, roughness, metallic, shading, castsShadow, lightColor, lightIntensity, lightRange, spotAngle, lightShadows, fieldOfView, focusDistance, aperture, portraitZoom, portraitShift, seed",
          "additionalProperties": {
            "$ref": "#/$defs/propertyValue"
          }
        }
      }
    },
    "easing": {
      "oneOf": [
        {
          "enum": [
            "linear",
            "easeIn",
            "easeOut",
            "easeInOut",
            "backOut",
            "bounce",
            "elastic",
            "step"
          ]
        },
        {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4,
          "description": "cubic bezier x1, y1, x2, y2"
        }
      ]
    },
    "keyframe": {
      "type": "object",
      "required": [
        "time",
        "value",
        "easing"
      ],
      "properties": {
        "time": {
          "type": "number",
          "minimum": 0
        },
        "value": {
          "$ref": "#/$defs/propertyValue"
        },
        "easing": {
          "$ref": "#/$defs/easing",
          "description": "Shapes the segment leaving this key."
        }
      }
    },
    "track": {
      "type": "object",
      "required": [
        "id",
        "target",
        "property",
        "keyframes"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "target": {
          "$ref": "#/$defs/id"
        },
        "property": {
          "type": "string"
        },
        "keyframes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/keyframe"
          }
        }
      }
    },
    "fragment": {
      "type": "object",
      "required": [
        "objects",
        "roots"
      ],
      "properties": {
        "objects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/object"
          }
        },
        "roots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "command": {
      "type": "object",
      "required": [
        "op"
      ],
      "oneOf": [
        {
          "properties": {
            "op": {
              "const": "insert"
            },
            "fragment": {
              "$ref": "#/$defs/fragment"
            },
            "parent": {
              "$ref": "#/$defs/id"
            },
            "index": {
              "type": "integer"
            }
          },
          "required": [
            "op",
            "fragment"
          ]
        },
        {
          "properties": {
            "op": {
              "const": "delete"
            },
            "ids": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              }
            }
          },
          "required": [
            "op",
            "ids"
          ]
        },
        {
          "properties": {
            "op": {
              "const": "setProperties"
            },
            "changes": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "object",
                  "key"
                ],
                "properties": {
                  "object": {
                    "$ref": "#/$defs/id"
                  },
                  "key": {
                    "type": "string"
                  },
                  "value": {
                    "$ref": "#/$defs/propertyValue"
                  }
                }
              }
            }
          },
          "required": [
            "op",
            "changes"
          ]
        },
        {
          "properties": {
            "op": {
              "const": "rename"
            },
            "id": {
              "$ref": "#/$defs/id"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "op",
            "id",
            "name"
          ]
        },
        {
          "properties": {
            "op": {
              "const": "setKind"
            },
            "id": {
              "$ref": "#/$defs/id"
            },
            "kind": {
              "$ref": "#/$defs/kind"
            }
          },
          "required": [
            "op",
            "id",
            "kind"
          ]
        },
        {
          "properties": {
            "op": {
              "const": "reparent"
            },
            "entries": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "object"
                ],
                "properties": {
                  "object": {
                    "$ref": "#/$defs/id"
                  },
                  "parent": {
                    "$ref": "#/$defs/id"
                  },
                  "index": {
                    "type": "integer"
                  }
                }
              }
            }
          },
          "required": [
            "op",
            "entries"
          ]
        },
        {
          "properties": {
            "op": {
              "const": "setLook"
            },
            "look": {
              "type": "object"
            },
            "scope": {
              "enum": [
                "project",
                "scene"
              ]
            }
          },
          "required": [
            "op",
            "scope"
          ]
        },
        {
          "properties": {
            "op": {
              "const": "renameScene"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "op",
            "name"
          ]
        },
        {
          "properties": {
            "op": {
              "const": "setActiveCamera"
            },
            "camera": {
              "$ref": "#/$defs/id"
            }
          },
          "required": [
            "op"
          ]
        },
        {
          "properties": {
            "op": {
              "const": "setTimeline"
            },
            "timeline": {
              "type": "object",
              "properties": {
                "fps": {
                  "enum": [
                    24,
                    25,
                    30,
                    60
                  ]
                },
                "duration": {
                  "type": "number"
                },
                "stepping": {
                  "enum": [
                    1,
                    2,
                    3
                  ]
                },
                "tracks": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/track"
                  }
                },
                "markers": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "time",
                      "name"
                    ]
                  }
                },
                "loop": {
                  "type": "object",
                  "required": [
                    "start",
                    "end"
                  ]
                },
                "cuts": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "time",
                      "camera"
                    ]
                  }
                },
                "behaviors": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "target",
                      "kind"
                    ],
                    "description": "kind.type: followPath | lookAt | follow | orbit | noise | windSway | bob | spin"
                  }
                },
                "clipTracks": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "target",
                      "segments"
                    ]
                  }
                }
              }
            }
          },
          "required": [
            "op",
            "timeline"
          ]
        },
        {
          "properties": {
            "op": {
              "const": "setTracks"
            },
            "tracks": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id"
                ],
                "properties": {
                  "id": {
                    "$ref": "#/$defs/id"
                  },
                  "track": {
                    "$ref": "#/$defs/track"
                  },
                  "index": {
                    "type": "integer"
                  }
                },
                "description": "Insert or replace a track; omit `track` to remove it."
              }
            }
          },
          "required": [
            "op",
            "tracks"
          ]
        },
        {
          "properties": {
            "op": {
              "const": "batch"
            },
            "label": {
              "type": "string"
            },
            "commands": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/command"
              }
            }
          },
          "required": [
            "op",
            "label",
            "commands"
          ]
        },
        {
          "properties": {
            "op": {
              "const": "restore"
            },
            "entries": {
              "type": "array"
            }
          },
          "required": [
            "op",
            "entries"
          ]
        }
      ]
    },
    "time": {
      "description": "Seconds, a keyword, a spoken word or a marker.",
      "oneOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "enum": [
            "now",
            "playhead",
            "start",
            "end"
          ]
        },
        {
          "type": "object",
          "required": [
            "word"
          ],
          "properties": {
            "word": {
              "type": "string"
            },
            "occurrence": {
              "type": "integer",
              "minimum": 1
            },
            "edge": {
              "enum": [
                "start",
                "end"
              ]
            },
            "offset": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "marker"
          ],
          "properties": {
            "marker": {
              "type": "string"
            },
            "offset": {
              "type": "number"
            }
          }
        }
      ]
    },
    "target": {
      "oneOf": [
        {
          "type": "string",
          "description": "Name (case-insensitive), \"Prefix*\", or id"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "point": {
      "oneOf": [
        {
          "$ref": "#/$defs/vec3"
        },
        {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        {
          "type": "string",
          "description": "an object name: its centre"
        }
      ]
    },
    "action": {
      "type": "object",
      "required": [
        "do"
      ],
      "properties": {
        "do": {
          "enum": [
            "add",
            "place",
            "text",
            "overlay",
            "particles",
            "character",
            "light",
            "camera",
            "set",
            "transform",
            "keys",
            "preset",
            "cameraMove",
            "cut",
            "look",
            "effect",
            "clip",
            "lipSync",
            "marker",
            "captions",
            "delete",
            "rename",
            "group",
            "array",
            "scatter",
            "length",
            "command"
          ]
        },
        "name": {
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "at": {
          "anyOf": [
            {
              "$ref": "#/$defs/time"
            },
            {
              "$ref": "#/$defs/point"
            }
          ]
        },
        "shape": {
          "type": "string"
        },
        "size": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "$ref": "#/$defs/vec3"
            }
          ]
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "rotation": {
          "$ref": "#/$defs/vec3",
          "description": "Euler degrees"
        },
        "preset": {
          "type": "string"
        },
        "move": {
          "type": "string"
        },
        "duration": {
          "type": "number"
        },
        "property": {
          "type": "string"
        },
        "value": {},
        "easing": {
          "type": "string"
        },
        "keys": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "value"
            ],
            "properties": {
              "t": {
                "$ref": "#/$defs/time"
              },
              "value": {},
              "easing": {
                "type": "string"
              }
            }
          }
        },
        "command": {
          "$ref": "#/$defs/command"
        }
      },
      "additionalProperties": true
    }
  },
  "anyOf": [
    {
      "required": [
        "commands"
      ]
    },
    {
      "required": [
        "actions"
      ]
    }
  ]
}
