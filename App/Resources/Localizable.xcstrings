    "On twos": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A due"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "على اثنين"
          }
        }
      }
    },
    "On twos looks hand-animated. Cameras stay smooth; any object can choose its own in the inspector.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A due sembra animato a mano. Le camere restano fluide; ogni oggetto può scegliere il suo nell'ispettore."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "على اثنين يبدو كرسوم يدوية. تبقى الكاميرات سلسة؛ ويمكن لأي عنصر اختيار معدله في المراقب."
          }
        }
      }
    },
    "One after another": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uno dopo l'altro"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "واحدًا تلو الآخر"
          }
        }
      }
    },
    "One finger draws until an Apple Pencil touches the screen. Then the Pencil draws and fingers move the view, unless this is on.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un dito disegna finché una Apple Pencil non tocca lo schermo. Poi disegna la Pencil e le dita muovono la vista, a meno che questo non sia attivo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إصبع واحد يرسم إلى أن يلمس قلم Apple الشاشة. بعدها يرسم القلم وتحرّك الأصابع المشهد، ما لم يكن هذا الخيار مفعّلًا."
          }
        }
      }
    },
    "One finger orbits, two pan and pinch. Double-tap something to frame it. Tap to select.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un dito ruota, due spostano e pizzicano. Tocca due volte qualcosa per inquadrarlo. Tocca per selezionare."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إصبع واحد للدوران، واثنان للتحريك والقرص. انقر مرتين على شيء لتأطيره. انقر للتحديد."
          }
        }
      }
    },
    "One frame earlier": {
      "localizations": {
