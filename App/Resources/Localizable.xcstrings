            "state": "translated",
            "value": "بداية السجلّ المحفوظ"
          }
        }
      }
    },
    "The subject isn't in the previous shot": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il soggetto non è nell'inquadratura precedente"
