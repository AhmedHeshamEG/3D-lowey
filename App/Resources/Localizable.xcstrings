{
  "sourceLanguage": "en",
  "strings": {
    " · HEVC with alpha (.mov)": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": " · HEVC con alfa (.mov)"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": " · HEVC مع شفافية (.mov)"
          }
        }
      }
    },
    "%@ goes off at %@": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ si spegne a %2$@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يختفي %1$@ عند %2$@"
          }
        }
      }
    },
    "%@ is here. Try an expression or lip sync": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è qui. Prova un'espressione o il lip sync"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ هنا. جرّب تعبيرًا أو مزامنة الشفاه"
          }
        }
      }
    },
    "%@ is ready. Try a clip, lip sync or your face": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è pronto. Prova una clip, il lip sync o il tuo viso"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ جاهز. جرّب مقطعًا أو مزامنة الشفاه أو وجهك"
          }
        }
      }
    },
    "%@ isn't audio %@ can read": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ non è un audio che %2$@ sa leggere"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ليس صوتًا يستطيع %2$@ قراءته"
          }
        }
      }
    },
    "%@ options": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Opzioni di %@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خيارات %@"
          }
        }
      }
    },
    "%@ × %@ · %@ fps · %@ s · %@ frames": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ × %@ · %@ fps · %@ s · %@ fotogrammi"
