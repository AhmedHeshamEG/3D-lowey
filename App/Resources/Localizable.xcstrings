    "Walls follow the corners you tap; doors and windows go where you tap a wall.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I muri seguono gli angoli che tocchi; porte e finestre vanno dove tocchi un muro."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الجدران تتبع الزوايا التي تلمسها؛ الأبواب والنوافذ توضع حيث تلمس جدارًا."
          }
        }
