    "Word timing runs on the iPad (Apple's speech recogniser; the language downloads once).": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tempi delle parole si calcolano sull'iPad (riconoscimento vocale Apple; la lingua si scarica una volta)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُحسب توقيت الكلمات على الآيباد (مُعرّف الكلام من Apple؛ تُنزَّل اللغة مرة واحدة)."
          }
        }
      }
    },
