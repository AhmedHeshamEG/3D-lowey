      }
    },
    "Off": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spento"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إيقاف"
          }
        }
      }
    },
    "Off: every change from Claude waits here as a proposal, with a preview. Each one is a single undo step.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattivo: ogni modifica di Claude attende qui come proposta, con un'anteprima. Ognuna è un solo annullamento."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "معطّل: كل تغيير من Claude ينتظر هنا كمقترح مع معاينة. كل منها خطوة تراجع واحدة."
          }
        }
      }
    },
    "Offset": {
      "localizations": {
