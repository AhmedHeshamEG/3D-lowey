            "state": "translated",
            "value": "الذقن"
          }
        }
      }
    },
    "The Director view looks through the shot camera. It's flying over the island now.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La vista regista guarda attraverso la camera dell'inquadratura. Ora sta volando sopra l'isola."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "منظور المخرج يرى عبر كاميرا اللقطة. إنها تطير فوق الجزيرة الآن."
          }
        }
      }
    },
    "The Enigma story": {
      "localizations": {
