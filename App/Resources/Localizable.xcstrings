    "Frame times against the 120 fps budget, p50 / p95 / p99 over the last five seconds, dropped frames, heat and memory.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempi dei fotogrammi rispetto al budget di 120 fps, p50 / p95 / p99 negli ultimi cinque secondi, fotogrammi persi, calore e memoria."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أزمنة الإطارات مقابل ميزانية 120 إطار/ث، p50 / p95 / p99 خلال آخر خمس ثوانٍ، الإطارات المفقودة، الحرارة والذاكرة."
          }
        }
      }
    },
