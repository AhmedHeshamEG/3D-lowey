    "Nothing archived. Archive a project from its menu (touch and hold) to tidy Home without deleting it.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente in archivio. Archivia un progetto dal suo menu (tieni premuto) per riordinare Home senza eliminarlo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا شيء في الأرشيف. أرشف مشروعًا من قائمته (المس مع الاستمرار) لترتيب الرئيسية دون حذفه."
          }
        }
      }
    },
    "Nothing archived. Archive a project from its menu (touch and hold) to tidy the Theater without deleting it.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun archivio. Archivia un progetto dal suo menu (tocca e tieni premuto) per riordinare il Teatro senza eliminarlo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا شيء مؤرشف. أرشف مشروعًا من قائمته (المس مطولًا) لترتيب المسرح دون حذفه."
          }
        }
      }
    },
    "Nothing called “%@”": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente che si chiami “%@”"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا شيء باسم “%@”"
          }
        }
