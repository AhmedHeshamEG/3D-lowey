        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التأليف يحرّك الحركات زمنيًا، والأداء يسجّل حركاتك، والإطار المفتاحي يضع المفاتيح. صوتك يحدد التوقيت."
