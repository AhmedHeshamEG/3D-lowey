            "state": "translated",
            "value": "%lld إطار/ث"
          }
        }
      }
    },
    "%lld joints. Draw another bone to add one; draw along a bone again to replace it.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld articolazioni. Disegna un altro osso per aggiungerne uno; ridisegna lungo un osso per sostituirlo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld مفصل. ارسم عظمة أخرى لإضافتها؛ وارسم على طول عظمة مرة أخرى لاستبدالها."
          }
        }
      }
    },
    "%lld joints. Select it and drag its joints on the stage to pose it; keys land at the playhead in Keyframe.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld articolazioni. Selezionalo e trascina le articolazioni sulla scena per metterlo in posa; in Keyframe le chiavi cadono sulla testina."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld مفصل. حدّده واسحب مفاصله على المسرح لتضعه في وضعية؛ في وضع الإطارات المفتاحية تُضاف المفاتيح عند رأس التشغيل."
          }
        }
      }
    },
    "%lld like “%@”": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld come “%2$@”"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld مثل “%2$@”"
