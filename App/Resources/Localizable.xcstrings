          "stringUnit": {
            "state": "translated",
            "value": "شبكة 25 سم، والمنظر من الأعلى."
          }
        }
      }
    },
    "A cold glow from below and in front: someone at a screen at night.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un bagliore freddo dal basso e davanti: qualcuno davanti a uno schermo di notte."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توهّج بارد من الأسفل والأمام: شخص أمام شاشة ليلًا."
          }
        }
      }
    },
    "a hip": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "un'anca"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ورك"
          }
        }
      }
    },
