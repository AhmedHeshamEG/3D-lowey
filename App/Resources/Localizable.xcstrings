{
  "sourceLanguage": "en",
  "strings": {
    " · HEVC with alpha (.mov)": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": " · HEVC con alfa (.mov)"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": " · HEVC مع شفافية (.mov)"
          }
        }
      }
    },
    "%@ goes off at %@": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ si spegne a %2$@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يختفي %1$@ عند %2$@"
          }
        }
      }
    },
    "%@ is here. Try an expression or lip sync": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è qui. Prova un'espressione o il lip sync"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ هنا. جرّب تعبيرًا أو مزامنة الشفاه"
          }
        }
      }
    },
    "%@ is ready. Try a clip, lip sync or your face": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è pronto. Prova una clip, il lip sync o il tuo viso"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ جاهز. جرّب مقطعًا أو مزامنة الشفاه أو وجهك"
          }
        }
      }
    },
    "%@ is rigged. Try a clip, or drag its hands and feet": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha lo scheletro. Prova una clip, o trascina mani e piedi"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أصبح لـ %@ هيكل عظمي. جرّب مقطعًا، أو اسحب يديه وقدميه"
          }
        }
      }
    },
    "%@ isn't audio %@ can read": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ non è un audio che %2$@ sa leggere"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ليس صوتًا يستطيع %2$@ قراءته"
          }
        }
      }
    },
    "%@ options": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Opzioni di %@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خيارات %@"
          }
        }
      }
    },
    "%@ × %@ · %@ fps · %@ s · %@ frames": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ × %@ · %@ fps · %@ s · %@ fotogrammi"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ × %@ · %@ إطار/ث · %@ ث · %@ إطارًا"
          }
        }
      }
    },
    "%@. Keep holding and drag to adjust": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Continua a tenere premuto e trascina per regolare"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. استمر بالضغط واسحب للضبط"
          }
        }
      }
    },
    "%lld accents in this shot. One accent per shot reads best.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld accenti in questa inquadratura. Un solo accento per inquadratura si legge meglio."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ألوان مميِّزة في هذه اللقطة. لون مميِّز واحد لكل لقطة أوضح."
          }
        }
      }
    },
    "%lld clips picked": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld clip selezionate"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم اختيار %lld مقاطع"
          }
        }
      }
    },
    "%lld corners": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld vertici"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld زوايا"
          }
        }
      }
    },
