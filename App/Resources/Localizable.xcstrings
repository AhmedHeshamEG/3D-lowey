            "value": "تعذّر تشغيل اختبار الأداء"
          }
        }
      }
    },
    "The board first: plan it, then build it.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima la lavagna: pianifica, poi costruisci."
          }
        },
