    "A cold glow from below and in front: someone at a screen at night.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un bagliore freddo dal basso e davanti: qualcuno davanti a uno schermo di notte."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توهّج بارد من الأسفل والأمام: شخص أمام شاشة ليلًا."
          }
        }
      }
    },
    "A laptop paired with the bridge": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un portatile si è collegato al bridge"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إقران حاسوب محمول بالجسر"
          }
        }
      }
    },
    "A laptop pairs once with a code that works one time, and keeps a token stored in the Keychain here.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un portatile si abbina una volta con un codice monouso e conserva un token salvato qui nel Portachiavi."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقترن الحاسوب المحمول مرة واحدة برمز يعمل لمرة واحدة، ويحتفظ برمز مميز محفوظ هنا في سلسلة المفاتيح."
          }
        }
      }
    },
