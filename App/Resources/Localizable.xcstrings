    "Tap a face and drag it. Tap the number to type an exact size, like 25 or 2*12.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca una faccia e trascinala. Tocca il numero per scrivere una misura esatta, come 25 o 2*12."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المس وجهًا واسحبه. المس الرقم لكتابة مقاس دقيق، مثل 25 أو 2*12."
          }
        }
      }
    },
    "Tap a line of a sketch to offset it": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca una linea dello schizzo per spostarla in parallelo"
          }
