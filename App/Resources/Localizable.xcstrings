    "Animate Emission (keys or Perform) to start and stop it.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anima Emissione (chiavi o Esegui) per avviarla e fermarla."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حرّك الانبعاث (مفاتيح أو أداء) لتشغيله وإيقافه."
          }
        }
      }
    },
    "Animate the selection here": {
