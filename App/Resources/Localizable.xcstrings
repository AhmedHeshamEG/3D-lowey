    "Symmetry keeps both sides alike as you model: whatever you change on one side, the other follows.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La simmetria tiene uguali i due lati mentre modelli: quello che cambi da una parte, l'altra lo segue."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التناظر يُبقي الجانبين متشابهين أثناء النمذجة: ما تغيّره في جانب يتبعه الجانب الآخر."
          }
