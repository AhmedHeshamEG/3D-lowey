          }
        }
      }
    },
    "The sidebar's sliders change with what you're doing. Two-finger tap undoes, three redoes.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I cursori della barra laterale cambiano con ciò che fai. Tocco a due dita annulla, a tre ripete."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتغيّر منزلقات الشريط الجانبي حسب ما تفعل. النقر بإصبعين يتراجع، وبثلاثة يعيد."
          }
        }
      }
    },
    "The stage now adapts its resolution to stay smooth.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ora il palco adatta la sua risoluzione per restare fluido."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يكيّف المسرح الآن دقته ليبقى سلسًا."
          }
        }
      }
    },
    "The start of the kept history": {
      "localizations": {
