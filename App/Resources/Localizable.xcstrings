        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المس خطًا في الرسم لإزاحته"
          }
        }
      }
    },
    "Tap a shape, a modelled part or a placed model to paint it.": {
      "localizations": {
        "paint-it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca una forma, una parte modellata o un modello inserito per dipingerlo."
          }
        },
        "paint-ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على شكل أو جزء منمذج أو نموذج موضوع لتطليه."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca una forma, una parte modellata o un modello inserito per dipingerlo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على شكل أو جزء منمذج أو نموذج موضوع لتطليه."
          }
        }
      }
    },
    "Tap a sound in the timeline to edit it.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca un suono nella timeline per modificarlo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر على صوت في الخط الزمني لتعديله."
          }
        }
      }
    },
    "Tap a stroke or draw a loop around strokes with the Pencil. Then drag them, or change them here.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca un tratto o disegna un anello attorno ai tratti con la Pencil. Poi trascinali o modificali qui."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر على خط أو ارسم حلقة حول الخطوط بالقلم. ثم اسحبها أو غيّرها هنا."
          }
        }
      }
    },
    "Tap an object to take its colour into palette slot %lld": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca un oggetto per prenderne il colore nello slot %lld della tavolozza"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر على عنصر لأخذ لونه إلى الخانة %lld في اللوحة"
          }
        }
      }
    },
    "Tap an object to take its colour into slot %lld": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca un oggetto per prenderne il colore nello slot %lld"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر على عنصر لأخذ لونه إلى الخانة %lld"
          }
        }
      }
    },
    "Tap how far it bends": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca quanto si piega"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المس مقدار انحنائه"
          }
        }
      }
    },
    "Tap on a face or the ground. Closed shapes fill; tap one and drag it up into a solid, or into a face to cut.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca una faccia o il terreno. Le forme chiuse si riempiono: toccane una e trascinala in su per farne un solido, o dentro una faccia per tagliare."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المس وجهًا أو الأرض. الأشكال المغلقة تمتلئ؛ المس واحدًا واسحبه للأعلى ليصبح مجسمًا، أو داخل وجه لتقطعه."
          }
        }
      }
    },
    "Tap one corner": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca un angolo"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المس زاوية"
          }
        }
      }
    },
    "Tap projects to select them": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca i progetti per selezionarli"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على المشاريع لتحديدها"
          }
        }
      }
    },
    "Tap the centre": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca il centro"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المس المركز"
          }
        }
      }
    },
    "Tap the corners of the floor. Tap the first one to finish": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca gli angoli del pavimento. Tocca il primo per finire"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المس زوايا الأرضية. المس الأولى لتنتهي"
          }
        }
      }
    },
    "Tap the corners of the walls. Tap the first one to close the room": {
      "localizations": {
