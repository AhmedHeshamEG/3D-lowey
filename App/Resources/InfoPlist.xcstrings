{
  "sourceLanguage" : "en",
  "strings" : {
    "NSCameraUsageDescription" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "يستخدم Maquette الكاميرا لتتبّع الآيباد عندما يعمل ككاميرا تصوير، والكاميرا الأمامية لقراءة وجهك في أداء الشخصيات." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Maquette uses the camera to follow the iPad when it acts as a film camera, and the front camera to read your face for character performances." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Maquette usa la fotocamera per seguire l'iPad quando fa da cinepresa, e la fotocamera frontale per leggere il tuo viso nelle interpretazioni dei personaggi." } }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "يتواصل Maquette مع حاسوبك المقترن (جسر الذكاء الاصطناعي والملفات) ومع آيفونك (التقاط الوجه) على شبكتك المحلية فقط." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Maquette talks to your paired laptop (AI bridge, files) and your iPhone (face capture) on your local network only." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Maquette comunica con il tuo portatile abbinato (bridge IA, file) e con il tuo iPhone (cattura del viso) solo sulla tua rete locale." } }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "يسجّل Maquette تعليقك الصوتي حتى تُضبط حركتك على توقيت كلماتك." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Maquette records your voiceover so your animation can be timed to your words." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Maquette registra la tua voce fuori campo per sincronizzare l'animazione con le tue parole." } }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "يحفظ Maquette الفيديوهات والصور التي تصدّرها في مكتبة صورك." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Maquette saves the videos and stills you export to your photo library." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Maquette salva nella tua libreria foto i video e le immagini che esporti." } }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "يحدد Maquette متى تُنطق كل كلمة، على هذا الآيباد، لتتزامن اللقطات مع تعليقك الصوتي." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Maquette finds when each word is spoken, on this iPad, so shots can be synced to your voiceover." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Maquette trova quando viene pronunciata ogni parola, su questo iPad, per sincronizzare le inquadrature con la tua voce." } }
      }
    }
  },
  "version" : "1.0"
}
