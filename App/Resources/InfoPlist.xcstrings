{
  "sourceLanguage" : "en",
  "strings" : {
    "NSCameraUsageDescription" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "يستخدم 3D-lowey الكاميرا لتتبّع الآيباد عندما يعمل ككاميرا تصوير، والكاميرا الأمامية لقراءة وجهك في أداء الشخصيات." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "3D-lowey uses the camera to follow the iPad when it acts as a film camera, and the front camera to read your face for character performances." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "3D-lowey usa la fotocamera per seguire l'iPad quando fa da cinepresa, e la fotocamera frontale per leggere il tuo viso nelle interpretazioni dei personaggi." } }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "يتواصل 3D-lowey مع حاسوبك المقترن (جسر الذكاء الاصطناعي والملفات) ومع آيفونك (التقاط الوجه) على شبكتك المحلية فقط." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "3D-lowey talks to your paired laptop (AI bridge, files) and your iPhone (face capture) on your local network only." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "3D-lowey comunica con il tuo portatile abbinato (bridge IA, file) e con il tuo iPhone (cattura del viso) solo sulla tua rete locale." } }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "يسجّل 3D-lowey تعليقك الصوتي حتى تُضبط حركتك على توقيت كلماتك." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "3D-lowey records your voiceover so your animation can be timed to your words." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "3D-lowey registra la tua voce fuori campo per sincronizzare l'animazione con le tue parole." } }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "يحفظ 3D-lowey الفيديوهات والصور التي تصدّرها في مكتبة صورك." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "3D-lowey saves the videos and stills you export to your photo library." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "3D-lowey salva nella tua libreria foto i video e le immagini che esporti." } }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "يحدد 3D-lowey متى تُنطق كل كلمة، على هذا الآيباد، لتتزامن اللقطات مع تعليقك الصوتي." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "3D-lowey finds when each word is spoken, on this iPad, so shots can be synced to your voiceover." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "3D-lowey trova quando viene pronunciata ogni parola, su questo iPad, per sincronizzare le inquadrature con la tua voce." } }
      }
    }
  },
  "version" : "1.0"
}
